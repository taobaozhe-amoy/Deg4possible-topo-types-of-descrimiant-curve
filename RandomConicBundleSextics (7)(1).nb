Cell[CellGroupData[{

Cell["", "Section",
 CellChangeTimes->{
  4.0032579066886654`*^9},ExpressionUUID->"e8660bad-c076-4a93-9514-\
ffa00595ca3e"],

Cell[CellGroupData[{

Cell["\<\
Print[\"Computing determinants...\"];
deltaList = Expand[Det[#]] & /@ aList;

types = Table[
  Module[{answer},
    Print[\"Processing \", i, \" / \", Length[aList]];

    Print[\"a = \", aList[[i, 1, 1]],
      \"\\nb = \", aList[[i, 1, 2]],
      \"\\nc = \", aList[[i, 1, 3]],
      \"\\nd = \", aList[[i, 2, 2]],
      \"\\ne = \", aList[[i, 2, 3]],
      \"\\nf = \", aList[[i, 3, 3]]];

answer = If[deltaList[[i]] === 0, \"Singular\",
  Block[{res},
    TopType[MakeGoodCoords[deltaList[[i]]]]
  ]
];

Print[\"Result = \", answer];
    Print[\"Result = \", answer];
    answer
  ],
  {i, Length[aList]}
];
results = Transpose[{Range[Length[aList]], types}];

uniqueTypes = DeleteDuplicates[Select[types,
  # === \"Empty\" || MatchQ[#, {_Integer} | {{_Integer, 1}, _Integer} | {1, \
1, 1}] &]];

uniqueTypes
\
\>", "Input",
