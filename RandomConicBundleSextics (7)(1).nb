Cell[CellGroupData[{

Cell["", "Section",
 CellChangeTimes->{
  4.0032579113109617`*^9},ExpressionUUID->"93baf8d5-4efe-49ef-ae75-\
c3f20b5ce3b4"],

Cell[CellGroupData[{

Cell["\<\
Clear[x, y, z, q];
SeedRandom[2026];

q[] := RandomInteger[{-3, 3}, 6].{x^2, y^2, z^2, x y, x z, y z};

aList = Table[
  With[{a = q[], b = q[], c = q[], d = q[], e = q[], f = q[]},
    {{a, b, c}, {b, d, e}, {c, e, f}}],
  {1000}];

Print[\"Matrix dimensions: \", Dimensions[aList]];
\
\>", "Input",
 Evaluator->"Local",
 Evaluatable->True,
 CellContext->"Global`",
 CellEvaluationFunction->Identity,
 CellLabel->
  "(\:8c03\:8bd5) \
In[63]:=",ExpressionUUID->"1417e9ce-550f-4d78-839b-7c9ad701830b"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Matrix dimensions: \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"1000", ",", "3", ",", "3"}], "}"}]}],
  SequenceForm["Matrix dimensions: ", {1000, 3, 3}],
  Editable->False]], "Print",
 CellChangeTimes->{4.0032579219349203`*^9},
 CellLabel->
  "(\:8c03\:8bd5) \
\:6b63\:5728\:8ba1\:7b97In[63]:=",ExpressionUUID->"4db1d146-ae48-438d-90f1-\
1c07badb6efb"]
}, Open  ]],

