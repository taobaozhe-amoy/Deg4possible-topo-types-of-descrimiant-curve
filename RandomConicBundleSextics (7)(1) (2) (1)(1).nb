Cell[CellGroupData[{

Cell["", "Section",
 CellChangeTimes->{
  4.0032579113109617`*^9},ExpressionUUID->"93baf8d5-4efe-49ef-ae75-\
c3f20b5ce3b4"],

Cell[CellGroupData[{

Cell["\<\
Clear[x, y, z, q1, q2, q3, q4, q5, q6, aList];
SeedRandom[2026];

(* a: only x^2 and y^2 terms *)
q1[] := RandomInteger[{-30, 30}, 3].{x^2, y^2, z^2};

(* b *)
q2[] := RandomInteger[{-30, 30}, 1].{x y};

(* c *)
q3[] := RandomInteger[{-30, 30}, 1].{x z};

(* d *)
q4[] := RandomInteger[{-30, 30}, 3].{x^2, y^2, z^2};


(* e *)
q5[] := RandomInteger[{-3, 3}, 1].{y z};

(* f *)
q6[] := RandomInteger[{-30, 30}, 3].{x^2, y^2, z^2};

aList = Table[
  With[
    {a = q1[], b = q2[], c = q3[],
     d = q4[], e = q5[], f = q6[]},
    {{a, b, c},
     {b, d, e},
     {c, e, f}}
  ],
  {1000}
];

Print[\"Matrix dimensions: \", Dimensions[aList]];\
\>", "Input",
 Evaluator->"Local",
 Evaluatable->True,
 CellContext->"Global`",
 CellEvaluationFunction->Identity,
 CellChangeTimes->{{4.003853845730345*^9, 4.0038539739717045`*^9}},
 CellLabel->
  "In[350]:=",ExpressionUUID->"1417e9ce-550f-4d78-839b-7c9ad701830b"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Matrix dimensions: \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"1000", ",", "3", ",", "3"}], "}"}]}],
  SequenceForm["Matrix dimensions: ", {1000, 3, 3}],
  Editable->False]], "Print",
 CellChangeTimes->{
  4.0032579219349203`*^9, {4.0038539536544857`*^9, 4.0038539787927265`*^9}, 
   4.003854010458681*^9, 4.0038609175655346`*^9},
